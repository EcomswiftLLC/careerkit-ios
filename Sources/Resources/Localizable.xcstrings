    "This removes every resume and cover letter stored in CareerKit on this device, including unreadable files and saved export passes.": {
      "comment": "Profile. Delete-all confirmation. Must be precise.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle in CareerKit auf diesem Gerät gespeicherten Lebensläufe und Anschreiben entfernt, einschließlich unlesbarer Dateien und gespeicherter Exportfreigaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los currículums y cartas de presentación guardados en CareerKit en este dispositivo, incluidos los archivos ilegibles y los pases de exportación guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime tous les CV et lettres de motivation enregistrés dans CareerKit sur cet appareil, y compris les fichiers illisibles et les exports débloqués en attente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除此设备上 CareerKit 中存储的所有简历和求职信，包括无法读取的文件和已保存的导出许可。"
          }
        }
      }
    },
    "This removes every resume and cover letter stored in CareerKit on this device, including unreadable files and saved video unlocks. Purchases are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle in CareerKit auf diesem Gerät gespeicherten Lebensläufe und Anschreiben gelöscht, einschließlich nicht lesbarer Dateien und gespeicherter Video-Freischaltungen. Deine Käufe bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los currículums y cartas de presentación guardados en CareerKit en este dispositivo, incluidos los archivos ilegibles y los desbloqueos por vídeo guardados. Tus compras se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime tous les CV et lettres de motivation enregistrés dans CareerKit sur cet appareil, y compris les fichiers illisibles et les déblocages par vidéo enregistrés. Vos achats sont conservés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除此设备上 CareerKit 中存储的所有简历和求职信，包括无法读取的文件和已保存的视频解锁记录。你的购买记录会保留。"
          }
        }
      }
    },
