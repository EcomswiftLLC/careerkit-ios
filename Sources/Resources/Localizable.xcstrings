    "The address \"%@\" does not look complete. Make sure it has a name, an @ sign and a domain.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse „%@“ wirkt unvollständig. Achten Sie auf einen Namen, ein @-Zeichen und eine Domain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección “%@” no parece completa. Asegúrate de que tenga un nombre, una @ y un dominio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse « %@ » semble incomplète. Vérifiez qu'elle contient un nom, un @ et un domaine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮箱“%@”似乎不完整。请确认它包含用户名、@ 符号和域名。"
          }
        }
      }
    },
    "The backup could not be created. Free up some space and try again.": {
      "comment": "Profile",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup konnte nicht erstellt werden. Geben Sie Speicherplatz frei und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la copia de seguridad. Libera espacio y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde n’a pas pu être créée. Libérez de l’espace et réessayez."
