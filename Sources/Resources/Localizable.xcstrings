    },
    "This file is not a CareerKit backup. Choose a file whose name starts with CareerKit-Backup.": {
      "comment": "Backup and restore. Keep CareerKit-Backup exactly (it is the file name).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
