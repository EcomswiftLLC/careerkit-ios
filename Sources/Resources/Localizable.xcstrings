        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %lld Prozent Ihres Textes wurden in sauberer Reihenfolge gefunden. Eine einspaltige Vorlage ist die sicherste Wahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alrededor del %lld por ciento de tu texto se encontró en un orden limpio. Una plantilla de una sola columna es la opción más segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %lld pour cent de votre texte a été trouvé dans le bon ordre. Un modèle à une seule colonne est le choix le plus sûr."
