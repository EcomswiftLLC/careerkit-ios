        }
      }
    },
    "Cut order processing time from three days to one by rewriting the checklist and removing duplicate steps.": {
      "comment": "Writing examples library (resume example text the person can insert). Fictional, generic.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkürzung der Auftragsbearbeitung von drei Tagen auf einen durch eine überarbeitete Checkliste ohne doppelte Arbeitsschritte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduje el tiempo de procesamiento de pedidos de tres días a uno reescribiendo la lista de comprobación y eliminando pasos duplicados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit le délai de traitement des commandes de trois jours à un en réécrivant la check-list et en supprimant les étapes en double."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重写操作清单并去除重复步骤，将订单处理时间从三天缩短至一天。"
          }
        }
      }
    },
