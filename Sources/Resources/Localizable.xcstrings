              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld viñeta tiene más de 45 palabras. Una o dos líneas por viñeta se leen más rápido."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld viñetas tienen más de 45 palabras. Una o dos líneas por viñeta se leen más rápido."
