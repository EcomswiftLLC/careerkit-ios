    "A4 is common in most of the world. US Letter is standard in the United States and Canada.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A4 ist fast überall üblich. US Letter ist der Standard in den USA und Kanada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A4 es el tamaño habitual en casi todo el mundo. US Letter es el estándar en Estados Unidos y Canadá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format A4 est courant presque partout. Le format US Letter est la norme aux États-Unis et au Canada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全球大多数地区通用 A4。美国和加拿大通用 US Letter。"
          }
        }
      }
    },
    "A4 is used in most countries. US Letter is used in the US and Canada.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A4 wird in den meisten Ländern verwendet, US Letter in den USA und Kanada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A4 se usa en la mayoría de los países. US Letter se usa en EE. UU. y Canadá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format A4 est utilisé dans la plupart des pays. Le format US Letter est utilisé aux États-Unis et au Canada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大多数国家使用 A4。美国和加拿大使用 US Letter。"
