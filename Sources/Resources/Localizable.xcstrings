    },
    "Maintained patient records in line with privacy rules and passed every internal audit.": {
      "comment": "Writing examples library (resume example text the person can insert). Fictional, generic.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
