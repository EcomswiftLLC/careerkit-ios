              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld puce compte plus de 45 mots. Une ou deux lignes par puce se parcourent plus facilement."
