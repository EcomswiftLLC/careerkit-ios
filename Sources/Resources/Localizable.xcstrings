    "The file may be damaged or not a PDF. Try exporting it again, or paste the text instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist möglicherweise beschädigt oder kein PDF. Exportieren Sie sie erneut oder fügen Sie stattdessen den Text ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que el archivo esté dañado o que no sea un PDF. Vuelve a exportarlo o pega el texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
