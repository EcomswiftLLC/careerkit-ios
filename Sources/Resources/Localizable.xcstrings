    },
    "The document could not be checked yet. Open the preview and try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument konnte noch nicht geprüft werden. Öffnen Sie die Vorschau und versuchen Sie es erneut."
          }
