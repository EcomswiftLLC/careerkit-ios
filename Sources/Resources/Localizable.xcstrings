          }
        }
      }
    },
    "Your photo is kept but hidden, because %@ has no photo area.": {
      "comment": "%@ is a template name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Foto bleibt erhalten, ist aber ausgeblendet, weil %@ keinen Fotobereich hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu foto se conserva, pero queda oculta porque %@ no tiene espacio para foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photo est conservée mais masquée, car %@ n’a pas d’emplacement photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片已保留但被隐藏，因为“%@”没有照片区域。"
          }
        }
      }
    },
    "Your photo shows on the %@ templates marked Photo. Templates without a photo area keep it hidden. Employers in some countries prefer resumes without a photo.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Foto erscheint in den %@ Vorlagen mit der Markierung Foto. Vorlagen ohne Fotobereich blenden es aus. In manchen Ländern bevorzugen Arbeitgeber Lebensläufe ohne Foto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu foto aparece en las %@ plantillas marcadas con Foto. Las plantillas sin espacio para foto la mantienen oculta. En algunos países, las empresas prefieren currículums sin foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photo apparaît sur les %@ modèles marqués Photo. Les modèles sans emplacement photo la masquent. Dans certains pays, les employeurs préfèrent les CV sans photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片会显示在标有“照片”的 %@ 个模板中。没有照片区域的模板会隐藏照片。在一些国家，雇主更喜欢不带照片的简历。"
          }
        }
      }
    },
    "Your photo shows on the %lld templates marked Photo. Templates without a photo area keep it hidden. Employers in some countries prefer resumes without a photo.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Foto erscheint in den %lld Vorlagen mit der Markierung Foto. Vorlagen ohne Fotobereich blenden es aus. In manchen Ländern bevorzugen Arbeitgeber Lebensläufe ohne Foto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu foto aparece en las %lld plantillas marcadas con Foto. Las plantillas sin espacio para foto la mantienen oculta. En algunos países, las empresas prefieren currículums sin foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photo apparaît sur les %lld modèles marqués Photo. Les modèles sans emplacement photo la masquent. Dans certains pays, les employeurs préfèrent les CV sans photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片会显示在标有“照片”的 %lld 个模板中。没有照片区域的模板会隐藏照片。在一些国家，雇主更喜欢不带照片的简历。"
          }
        }
      }
    },
    "Your professional title": {
      "comment": "Sample title in the blank builder preview.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Berufsbezeichnung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu título profesional"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre intitulé de poste"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的职位头衔"
          }
        }
      }
    },
    "Your purchase is waiting for approval. The export will be available once it is approved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Genehmigung. Der Export ist verfügbar, sobald er genehmigt wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación. La exportación estará disponible cuando se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat attend une approbation. L’export sera disponible dès qu’il sera approuvé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的购买正在等待批准。批准后即可导出。"
          }
        }
      }
    },
    "Your resumes, cover letters and drafts cannot be recovered afterwards unless you saved a backup file.": {
      "comment": "Profile. Second delete-all confirmation. Must be precise.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Lebensläufe, Anschreiben und Entwürfe können danach nicht wiederhergestellt werden, es sei denn, Sie haben eine Backup-Datei gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después no podrás recuperar tus currículums, cartas de presentación ni borradores, salvo que hayas guardado un archivo de copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos CV, lettres de motivation et brouillons ne pourront pas être récupérés ensuite, sauf si vous avez enregistré un fichier de sauvegarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后，你的简历、求职信和草稿将无法恢复，除非你已保存备份文件。"
          }
        }
      }
    },
    "Your summary has %lld words. A couple of sentences gives a reader more to work with.": {
      "comment": "The number is always under 20.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ihr Kurzprofil hat %lld Wort. Ein paar Sätze geben mehr Anhaltspunkte."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ihr Kurzprofil hat %lld Wörter. Ein paar Sätze geben mehr Anhaltspunkte."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your summary has %lld word. A couple of sentences gives a reader more to work with."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your summary has %lld words. A couple of sentences gives a reader more to work with."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tu resumen tiene %lld palabra. Un par de frases da más información al lector."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tu resumen tiene %lld palabras. Un par de frases da más información al lector."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Votre résumé compte %lld mot. Quelques phrases donnent davantage d'éléments au lecteur."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Votre résumé compte %lld mots. Quelques phrases donnent davantage d'éléments au lecteur."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的个人简介约有 %lld 个词。写上两三句话，能给阅读者更多信息。"
          }
        }
      }
    },
    "Your summary has %lld words. Around 40 to 90 words is easier to read at a glance.": {
      "comment": "The number is always more than 120. For Chinese the app counts about one word per two characters.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Kurzprofil hat %lld Wörter. Etwa 40 bis 90 Wörter lassen sich auf einen Blick besser lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu resumen tiene %lld palabras. Entre 40 y 90 palabras se lee mejor de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre résumé compte %lld mots. Entre 40 et 90 mots, il se lit plus facilement d'un coup d'œil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的个人简介约有 %lld 个词。控制在 40 到 90 个词左右更便于快速阅读。"
          }
        }
      }
