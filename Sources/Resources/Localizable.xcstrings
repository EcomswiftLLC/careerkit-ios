    "Please accept my application for the {role} role at {company}. I bring several years of relevant experience and a steady record of delivering what I promise.": {
      "comment": "Cover letter suggestion. Letter content: formal register. Placeholders {company} {manager} {position} are replaced by the app; translations use {position} (a full noun phrase) instead of {role}.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte berücksichtigen Sie meine Bewerbung für {position} bei {company}. Ich bringe mehrere Jahre einschlägige Erfahrung mit und halte zuverlässig, was ich zusage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ruego que considere mi candidatura para {position} en {company}. Aporto varios años de experiencia relevante y un historial constante de cumplir lo que prometo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vous prie de bien vouloir examiner ma candidature pour {position} au sein de {company}. J’apporte plusieurs années d’expérience pertinente et l’habitude de tenir mes engagements."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诚请考虑我对{company}{position}的申请。我拥有多年相关经验，一贯说到做到。"
          }
        }
      }
    },
