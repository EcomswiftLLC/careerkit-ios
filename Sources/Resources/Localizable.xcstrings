    "Writing help does not support this language yet. Your text is unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schreibhilfe unterstützt diese Sprache noch nicht. Ihr Text bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ayuda de redacción aún no admite este idioma. Tu texto no ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aide à la rédaction ne prend pas encore en charge cette langue. Votre texte n’a pas changé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写作助手暂不支持这种语言。你的文字没有改动。"
          }
        }
      }
    },
    "Writing help is not ready on this device right now. Your text is unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schreibhilfe ist auf diesem Gerät gerade nicht bereit. Ihr Text bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ayuda de redacción no está lista en este dispositivo ahora mismo. Tu texto no ha cambiado."
          }
        },
        "fr": {
