    },
    "Nothing is uploaded. Scanned pages and photos of a resume hold pictures of text rather than text, so they cannot be imported.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts hochgeladen. Gescannte Seiten und Fotos eines Lebenslaufs enthalten Bilder von Text statt Text und können daher nicht importiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se sube nada. Las páginas escaneadas y las fotos de un currículum contienen imágenes del texto, no texto, por lo que no se pueden importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est envoyé en ligne. Les pages numérisées et les photos d'un CV contiennent des images de texte, pas du texte : elles ne peuvent pas être importées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
