          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette offre est longue. Seuls les 20 000 premiers caractères sont comparés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条职位描述较长，只会对比前 20,000 个字符。"
          }
        }
      }
    },
    "This backup was made with a newer version of CareerKit. Update the app, then try again.": {
      "comment": "Backup and restore",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup wurde mit einer neueren Version von CareerKit erstellt. Aktualisieren Sie die App und versuchen Sie es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad se creó con una versión más reciente de CareerKit. Actualiza la app y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde a été créée avec une version plus récente de CareerKit. Mettez l’app à jour, puis réessayez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份由较新版本的 CareerKit 创建。请更新 App 后重试。"
          }
        }
      }
    },
    "This design uses a sidebar, photo or decorative layout. It looks distinctive in print and as a PDF, but for online application forms an ATS friendly template is usually the safer choice.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Design nutzt eine Seitenleiste, ein Foto oder dekorative Elemente. Gedruckt und als PDF fällt es auf, für Online-Bewerbungsformulare ist eine ATS-freundliche Vorlage meist die sicherere Wahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este diseño usa una barra lateral, una foto o elementos decorativos. Destaca impreso y en PDF, pero para formularios de solicitud en línea una plantilla apta para ATS suele ser la opción más segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle utilise une barre latérale, une photo ou une mise en page décorative. Il se distingue à l'impression et en PDF, mais pour les formulaires de candidature en ligne, un modèle compatible ATS est en général plus sûr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设计使用了侧栏、照片或装饰性版式。打印和导出 PDF 时很有辨识度，但用于在线申请表时，适配 ATS 的模板通常更稳妥。"
          }
        }
      }
    },
    "This file could not be opened": {
