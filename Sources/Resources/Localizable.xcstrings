    "CareerKit has no subscription and no paywall. This is the full picture of where ads appear and why.": {
      "comment": "Profile > How exports work",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CareerKit hat kein Abo und keine Bezahlschranke. Hier sehen Sie vollständig, wo Werbung erscheint und warum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CareerKit no tiene suscripción ni muro de pago. Aquí tienes toda la información sobre dónde aparecen los anuncios y por qué."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CareerKit n’a ni abonnement ni accès payant. Voici, en toute transparence, où les publicités apparaissent et pourquoi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CareerKit 没有订阅，也没有付费墙。以下完整说明了广告出现的位置和原因。"
          }
        }
      }
    },
    "CareerKit imports PDFs up to 10 MB. Export a smaller copy, or paste the text instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CareerKit importiert PDFs bis 10 MB. Exportieren Sie eine kleinere Kopie oder fügen Sie stattdessen den Text ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CareerKit importa PDF de hasta 10 MB. Exporta una copia más pequeña o pega el texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CareerKit importe les PDF jusqu'à 10 Mo. Exportez une copie plus légère ou collez plutôt le texte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CareerKit 可导入最大 10 MB 的 PDF。请导出一个更小的副本，或直接粘贴文字。"
          }
        }
      }
    },
    "CareerKit is free. Exporting a finished document needs one short rewarded video. Everything else has no ad wall.": {
      "comment": "Onboarding",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CareerKit ist kostenlos. Zum Exportieren eines fertigen Dokuments ist ein kurzes Video mit Belohnung nötig. Alles andere ist ohne Werbezwang nutzbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CareerKit es gratis. Para exportar un documento terminado hay que ver un breve vídeo con recompensa. Todo lo demás funciona sin anuncios obligatorios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CareerKit est gratuit. Pour exporter un document terminé, il faut regarder une courte vidéo avec récompense. Tout le reste est accessible sans publicité obligatoire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CareerKit 免费使用。导出完成的文档需要观看一段简短的激励视频。其他功能都不会强制显示广告。"
          }
        }
      }
    },
