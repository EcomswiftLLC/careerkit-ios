    "Each example starts with an action and ends with a result. Replace the numbers with your own, and only keep what is true for you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Beispiel beginnt mit einer Tätigkeit und endet mit einem Ergebnis. Ersetzen Sie die Zahlen durch Ihre eigenen und behalten Sie nur, was auf Sie zutrifft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ejemplo empieza con una acción y termina con un resultado. Cambia las cifras por las tuyas y quédate solo con lo que sea cierto en tu caso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque exemple commence par une action et se termine par un résultat. Remplacez les chiffres par les vôtres et ne gardez que ce qui est vrai pour vous."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个示例都以行动开头、以结果结尾。请把数字换成你自己的，只保留符合你实际情况的内容。"
          }
        }
      }
    },
