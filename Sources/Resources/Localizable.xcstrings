    "The App Store could not be reached. Check your connection and try again. Nothing was charged.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store ist nicht erreichbar. Prüfe deine Verbindung und versuche es erneut. Es wurde nichts berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con la App Store. Comprueba tu conexión e inténtalo de nuevo. No se ha cobrado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store est inaccessible. Vérifiez votre connexion et réessayez. Rien n’a été débité."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 App Store。请检查网络后重试。未产生任何扣费。"
          }
        }
      }
    },
    "The App Store could not confirm this purchase, so nothing was added. Nothing was charged.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store konnte diesen Kauf nicht bestätigen, deshalb wurde nichts hinzugefügt. Es wurde nichts berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La App Store no pudo confirmar esta compra, así que no se añadió nada. No se ha cobrado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store n’a pas pu confirmer cet achat, rien n’a donc été ajouté. Rien n’a été débité."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 无法确认此次购买，因此未添加任何内容。未产生任何扣费。"
          }
        }
      }
    },
