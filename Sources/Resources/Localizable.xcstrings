    },
    "Some software can mix the lines of two columns. A single column template avoids this.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Software vermischt die Zeilen zweier Spalten. Eine einspaltige Vorlage vermeidet das."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos programas pueden mezclar las líneas de dos columnas. Una plantilla de una sola columna lo evita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains logiciels peuvent mélanger les lignes de deux colonnes. Un modèle à une seule colonne évite ce problème."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些软件可能会把两栏的文字行混在一起。单栏模板可以避免这种情况。"
          }
        }
      }
    },
    "Some software reads a sidebar before or after the main text, or mixes the two. A single column template avoids this.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Software liest eine Seitenleiste vor oder nach dem Haupttext oder vermischt beides. Eine einspaltige Vorlage vermeidet das."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos programas leen la barra lateral antes o después del texto principal, o los mezclan. Una plantilla de una sola columna lo evita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains logiciels lisent la colonne latérale avant ou après le texte principal, ou mélangent les deux. Un modèle à une seule colonne évite ce problème."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些软件会在正文之前或之后读取侧栏，或把两者混在一起。单栏模板可以避免这种情况。"
          }
        }
      }
    },
    "Some text reads back out of order": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile des Textes werden in falscher Reihenfolge gelesen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte del texto se lee desordenado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie du texte se lit dans le désordre"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分文字读取顺序错乱"
          }
        }
      }
    },
    "Something went wrong, so nothing was exported. Your export is still available. Please try again.": {
      "comment": "Export sheet",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen, daher wurde nichts exportiert. Ihr Export ist weiterhin verfügbar. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal y no se exportó nada. Tu exportación sigue disponible. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu et rien n’a été exporté. Votre export reste disponible. Veuillez réessayer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出现问题，未导出任何内容。你的导出机会仍然可用，请重试。"
          }
        }
      }
    },
