{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" uses the %@ design. The %@ letter template shares it, so the two documents look like a set.": {
      "comment": "Cover letter editor form. 1: resume title, 2: resume template name, 3: letter template name. Keep the order.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nutzt das Design %@. Die Anschreiben-Vorlage %@ verwendet dasselbe Design, sodass beide Dokumente zusammenpassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» usa el diseño %@. La plantilla de carta %@ comparte ese diseño, así que los dos documentos forman un conjunto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » utilise le design %@. Le modèle de lettre %@ reprend ce design, vos deux documents forment donc un ensemble."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”使用%@设计。%@求职信模板采用相同设计，两份文件风格一致。"
          }
        }
      }
    },
    "\"%@\" will be removed from this device. This cannot be undone.": {
      "comment": "Cover Letters list; Resume quick actions (Home, My Resumes). Delete confirmation. %@ is the document title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird von diesem Gerät entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se eliminará de este dispositivo. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » sera supprimé de cet appareil. Cette action est irréversible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将从此设备中删除。此操作无法撤销。"
          }
        }
      }
    },
    "%@ \"%@\" is the one you edited last.": {
      "comment": "Home. Home subtitle. 1: the sentence 'You have N resumes.', 2: resume title. Keep the order.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ „%@“ haben Sie zuletzt bearbeitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ «%@» es el que editaste por última vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ « %@ » est le dernier que vous avez modifié."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@“%@”是你最近编辑的一份。"
          }
        }
      }
    },
