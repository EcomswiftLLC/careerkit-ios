    "Maintained a 99 percent on-time dispatch rate through peak season.": {
      "comment": "Writing examples library (resume example text the person can insert). Fictional, generic.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Termintreue im Versand von 99 Prozent während der Hochsaison."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantuve una tasa de envíos puntuales del 99 por ciento durante la temporada alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenu un taux d’expédition à l’heure de 99 pour cent pendant la haute saison."
