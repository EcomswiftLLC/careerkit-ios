    "Export packs are used up one export at a time. Premium is a single purchase with no limit, and Restore purchases brings it back on a new device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Export-Pakete werden Export für Export verbraucht. Premium ist ein einmaliger Kauf ohne Limit, und mit Käufe wiederherstellen bekommst du es auf einem neuen Gerät zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los paquetes de exportaciones se gastan de una en una. Premium es una compra única sin límite, y Restaurar compras la recupera en un dispositivo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les packs d’exports se consomment un export à la fois. Premium est un achat unique sans limite, et Restaurer les achats le retrouve sur un nouvel appareil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出包按每次导出逐次用完。Premium 为一次性购买，不限次数，换新设备后可通过“恢复购买”找回。"
          }
        }
      }
    },
