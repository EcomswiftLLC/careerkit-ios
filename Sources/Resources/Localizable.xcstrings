    "Filter by industry, career level and style. Every template is free, and you can change templates later without retyping anything.": {
      "comment": "Onboarding",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtern Sie nach Branche, Karrierestufe und Stil. Alle Vorlagen sind kostenlos, und Sie können die Vorlage später wechseln, ohne etwas neu einzugeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra por sector, nivel profesional y estilo. Todas las plantillas son gratis y puedes cambiar de plantilla más adelante sin volver a escribir nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrez par secteur, niveau d’expérience et style. Tous les modèles sont gratuits, et vous pouvez en changer plus tard sans rien ressaisir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可按行业、职业阶段和风格筛选。所有模板均免费，之后更换模板也无需重新输入任何内容。"
          }
        }
      }
    },
    "Final-year computer science student with two team projects and a part-time role in a campus help desk. Looking for a junior developer position where I can learn from experienced colleagues.": {
      "comment": "Writing examples library (resume example text the person can insert). Fictional, generic.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Informatikstudent im letzten Studienjahr mit zwei Teamprojekten und einer Teilzeitstelle im IT-Helpdesk der Hochschule. Ich suche eine Junior-Entwicklerstelle, in der ich von erfahrenen Kolleginnen und Kollegen lernen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estudiante de último curso de Informática con dos proyectos en equipo y un trabajo a tiempo parcial en el servicio de ayuda del campus. Busco un puesto de desarrollador júnior donde aprender de compañeros con experiencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étudiant en dernière année d’informatique, avec deux projets d’équipe et un emploi à temps partiel au service d’assistance du campus. Je recherche un poste de développeur junior pour apprendre auprès de collègues expérimentés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算机科学专业大四学生，参与过两个团队项目，并在校园技术支持中心兼职。希望获得初级开发岗位，向经验丰富的同事学习。"
          }
        }
      }
    },
    "Finance and administration": {
      "comment": "Writing examples library (resume example text the person can insert). Fictional, generic.",
      "extractionState": "manual",
      "localizations": {
        "de": {
