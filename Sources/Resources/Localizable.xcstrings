      }
    },
    "Switching templates changes the look only. Your text, sections and photo stay as they are.": {
      "extractionState": "manual",
      "localizations": {}
    },
    "Symbols and pictures such as %@ may not be read by some software. Plain words are safer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbole und Bildzeichen wie %@ werden von mancher Software nicht gelesen. Einfache Wörter sind sicherer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que algunos programas no lean símbolos e imágenes como %@. Las palabras sencillas son más seguras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains logiciels peuvent ne pas lire les symboles et pictogrammes comme %@. Des mots simples sont plus sûrs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些软件可能无法读取 %@ 这类符号和图形。使用普通文字更稳妥。"
          }
        }
      }
    },
