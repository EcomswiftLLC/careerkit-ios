    "Some data could not be deleted. Restart the app and try again.": {
      "comment": "Profile",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Daten konnten nicht gelöscht werden. Starten Sie die App neu und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron eliminar algunos datos. Reinicia la app y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines données n’ont pas pu être supprimées. Redémarrez l’app et réessayez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分数据无法删除。请重新启动 App 后重试。"
          }
        }
      }
    },
    "Some employers prefer to call. Leave it out if you would rather be contacted by email.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Arbeitgeber rufen lieber an. Lassen Sie sie weg, wenn Sie lieber per E-Mail kontaktiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos empleadores prefieren llamar. Omítelo si prefieres que te contacten por correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains employeurs préfèrent appeler. Ne l'indiquez pas si vous préférez être contacté par e-mail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些雇主更喜欢打电话联系。如果你更希望通过邮件联系，可以不填。"
          }
        }
      }
    },
    "Some files could not be deleted. Restart the app and try again.": {
      "comment": "Profile",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
