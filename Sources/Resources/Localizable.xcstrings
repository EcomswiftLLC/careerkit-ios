    "Write one letter per job. Pick a template, link a resume to fill in your details, and export when it reads well.": {
      "comment": "Cover Letters list",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie ein Anschreiben pro Stelle. Wählen Sie eine Vorlage, verknüpfen Sie einen Lebenslauf für Ihre Daten und exportieren Sie, wenn der Text passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una carta por oferta. Elige una plantilla, vincula un currículum para rellenar tus datos y exporta cuando te convenza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédigez une lettre par offre. Choisissez un modèle, associez un CV pour remplir vos coordonnées, puis exportez quand le texte vous convient."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个职位写一封求职信。选择模板，关联简历以填入你的信息，满意后再导出。"
