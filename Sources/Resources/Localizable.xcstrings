    "A short skills list helps a reader match you to a role quickly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Liste Ihrer Kenntnisse hilft, Sie schnell einer Stelle zuzuordnen."
          }
        },
        "es": {
          "stringUnit": {
