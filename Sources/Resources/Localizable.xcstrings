    "Premium can be restored on a new device with Restore purchases in Profile. Export packs are used up as you export, so they cannot be restored.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium lässt sich auf einem neuen Gerät mit Käufe wiederherstellen im Profil zurückholen. Export-Pakete werden beim Exportieren verbraucht und können deshalb nicht wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium se puede recuperar en un dispositivo nuevo con Restaurar compras en Perfil. Los paquetes de exportaciones se gastan al exportar, por lo que no se pueden restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium peut être retrouvé sur un nouvel appareil avec Restaurer les achats dans Profil. Les packs d’exports se consomment au fil des exports et ne peuvent donc pas être restaurés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换新设备后，可在“个人资料”中通过“恢复购买”找回 Premium。导出包会随导出用完，因此无法恢复。"
          }
        }
      }
    },
    "Premium has no limit on exports.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Premium gibt es kein Export-Limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium no tiene límite de exportaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium n’a aucune limite d’exports."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium 不限制导出次数。"
          }
        }
      }
    },
    "Premium is active again.": {
