                  "state": "translated",
                  "value": "The number has %lld digits. Include the country code if you apply abroad."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "El número tiene %lld dígito. Incluye el prefijo del país si te postulas en el extranjero."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "El número tiene %lld dígitos. Incluye el prefijo del país si te postulas en el extranjero."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Le numéro comporte %lld chiffre. Ajoutez l'indicatif du pays si vous postulez à l'étranger."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Le numéro comporte %lld chiffres. Ajoutez l'indicatif du pays si vous postulez à l'étranger."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该号码有 %lld 位数字。如果申请海外职位，请加上国家或地区代码。"
          }
        }
      }
    },
    "The paper size is used for new documents. Existing ones keep their own size.": {
      "comment": "Profile",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Papierformat gilt für neue Dokumente. Vorhandene behalten ihr Format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño de papel se usa para los documentos nuevos. Los existentes conservan su tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format est utilisé pour les nouveaux documents. Les documents existants gardent leur format."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此纸张尺寸用于新文档，现有文档保留原来的尺寸。"
          }
        }
      }
    },
    "The photo only appears on templates that have a photo area. Some employers prefer resumes without one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto erscheint nur bei Vorlagen mit Fotobereich. Manche Arbeitgeber bevorzugen Lebensläufe ohne Foto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto solo aparece en las plantillas que tienen un área de foto. Algunos empleadores prefieren currículums sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo n’apparaît que sur les modèles dotés d’une zone photo. Certains employeurs préfèrent les CV sans photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片仅会显示在带有照片区域的模板上。有些雇主更倾向于不带照片的简历。"
          }
        }
      }
    },
    "The purchase did not go through. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wurde nicht abgeschlossen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra no se completó. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat n’a pas abouti. Vérifiez votre connexion et réessayez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买未能完成。请检查网络后重试。"
          }
        }
      }
    },
    "The purchase went through, but it could not be added yet. Tap Restore purchases in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wurde abgeschlossen, konnte aber noch nicht hinzugefügt werden. Tippe in einem Moment auf Käufe wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra se realizó, pero aún no se pudo añadir. Toca Restaurar compras dentro de un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat a abouti, mais il n’a pas pu être ajouté pour l’instant. Touchez Restaurer les achats dans un instant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买已完成，但暂时无法添加。请稍后点按“恢复购买”。"
          }
        }
      }
    },
    "The section and everything in it will be removed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abschnitt und sein gesamter Inhalt werden entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitarán la sección y todo su contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La section et tout son contenu seront retirés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该板块及其中的全部内容将被移除。"
          }
        }
      }
    },
    "The suggestion added details that are not in your text, so it was not used.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorschlag enthielt Angaben, die nicht in Ihrem Text stehen, und wurde daher nicht verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sugerencia añadía datos que no están en tu texto, así que no se ha usado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suggestion ajoutait des détails absents de votre texte, elle n’a donc pas été utilisée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议中加入了你的文字里没有的内容，因此未被采用。"
          }
        }
      }
    },
    "The text in the PDF can be selected and read in order, which is what parsing software needs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text im PDF lässt sich markieren und in der richtigen Reihenfolge lesen. Genau das braucht Auswertungssoftware."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto del PDF se puede seleccionar y leer en orden, que es lo que necesita el software de análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte du PDF peut être sélectionné et lu dans l'ordre, ce dont un logiciel d'analyse a besoin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 中的文字可以选中并按顺序读取，这正是解析软件所需要的。"
          }
        }
      }
    },
    "The text uses ordinary letters, numbers and punctuation.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text verwendet normale Buchstaben, Zahlen und Satzzeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto usa letras, números y signos de puntuación comunes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte utilise des lettres, des chiffres et une ponctuation ordinaires."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字只使用了常规的字母、数字和标点。"
          }
        }
      }
    },
    "The unreadable files were deleted.": {
      "comment": "Profile",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die unlesbaren Dateien wurden gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminaron los archivos ilegibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers illisibles ont été supprimés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取的文件已删除。"
          }
        }
