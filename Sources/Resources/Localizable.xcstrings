    "Ads come from Google AdMob and follow the consent choices you make. You can change them later in Profile.": {
      "comment": "Onboarding",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werbung stammt von Google AdMob und richtet sich nach Ihren Einwilligungsentscheidungen. Sie können diese später unter Profil ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los anuncios proceden de Google AdMob y respetan las opciones de consentimiento que elijas. Puedes cambiarlas más adelante en Perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publicités sont fournies par Google AdMob et respectent vos choix de consentement. Vous pourrez les modifier plus tard dans Profil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广告由 Google AdMob 提供，并遵循你做出的同意选择。你之后可以在个人资料中更改这些选择。"
          }
        }
      }
    },
