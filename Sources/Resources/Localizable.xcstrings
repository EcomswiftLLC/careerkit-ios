    "%lld bullets have more than 45 words. One or two lines each is easier to scan.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Aufzählungspunkt hat mehr als 45 Wörter. Ein bis zwei Zeilen pro Punkt lassen sich leichter überfliegen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Aufzählungspunkte haben mehr als 45 Wörter. Ein bis zwei Zeilen pro Punkt lassen sich leichter überfliegen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld bullet has more than 45 words. One or two lines each is easier to scan."
