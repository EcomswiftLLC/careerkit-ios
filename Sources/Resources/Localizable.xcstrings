            "value": "Diese Datei ist kein CareerKit-Backup. Wählen Sie eine Datei, deren Name mit CareerKit-Backup beginnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no es una copia de seguridad de CareerKit. Elige un archivo cuyo nombre empiece por CareerKit-Backup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
