          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "细边框"
          }
        }
      }
    },
    "Third item": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dritter Eintrag"
          }
        },
        "es": {
          "stringUnit": {
