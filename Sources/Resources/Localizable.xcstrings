    "Text in the sidebar switches to stay readable.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text in der Seitenleiste wechselt die Farbe, damit er lesbar bleibt."
