        }
      }
    },
    "The number has %lld digits. Include the country code if you apply abroad.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Nummer hat %lld Ziffer. Geben Sie bei Bewerbungen im Ausland die Ländervorwahl an."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Nummer hat %lld Ziffern. Geben Sie bei Bewerbungen im Ausland die Ländervorwahl an."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The number has %lld digit. Include the country code if you apply abroad."
                }
              },
