    "Applicant tracking systems read the text inside your PDF. These checks look at the document the same way, using the exact file you would export.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerbermanagementsysteme (ATS) lesen den Text in Ihrem PDF. Diese Prüfungen betrachten das Dokument auf die gleiche Weise und nutzen genau die Datei, die Sie exportieren würden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sistemas de seguimiento de candidatos (ATS) leen el texto de tu PDF. Estas revisiones analizan el documento de la misma forma, con el mismo archivo que exportarías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les logiciels de recrutement (ATS) lisent le texte de votre PDF. Ces vérifications examinent le document de la même façon, à partir du fichier exact que vous exporteriez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "招聘管理系统（ATS）会读取 PDF 中的文字。这些检查用同样的方式查看文档，使用的就是你将要导出的那个文件。"
          }
        }
      }
    },
