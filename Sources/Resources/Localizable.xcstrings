          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CareerKit lee el texto de tu currículum y lo organiza en secciones. Revisas el resultado antes de que se guarde nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
