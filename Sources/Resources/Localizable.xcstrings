    "This ad is long. Only the first 20,000 characters are compared.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anzeige ist lang. Nur die ersten 20.000 Zeichen werden verglichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta oferta es larga. Solo se comparan los primeros 20.000 caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette offre est longue. Seuls les 20 000 premiers caractères sont comparés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条职位描述较长，只会对比前 20,000 个字符。"
          }
        }
      }
    },
    "This backup was made with a newer version of CareerKit. Update the app, then try again.": {
      "comment": "Backup and restore",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup wurde mit einer neueren Version von CareerKit erstellt. Aktualisieren Sie die App und versuchen Sie es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad se creó con una versión más reciente de CareerKit. Actualiza la app y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde a été créée avec une version plus récente de CareerKit. Mettez l’app à jour, puis réessayez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份由较新版本的 CareerKit 创建。请更新 App 后重试。"
          }
        }
      }
    },
    "This design uses a sidebar, photo or decorative layout. It looks distinctive in print and as a PDF, but for online application forms an ATS friendly template is usually the safer choice.": {
      "extractionState": "manual",
      "localizations": {}
    },
