      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtern Sie nach Branche, Karrierestufe und Stil. Alle Vorlagen sind kostenlos, und Sie können die Vorlage später wechseln, ohne etwas neu einzugeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra por sector, nivel profesional y estilo. Todas las plantillas son gratis y puedes cambiar de plantilla más adelante sin volver a escribir nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrez par secteur, niveau d’expérience et style. Tous les modèles sont gratuits, et vous pouvez en changer plus tard sans rien ressaisir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可按行业、职业阶段和风格筛选。所有模板均免费，之后更换模板也无需重新输入任何内容。"
          }
        }
