            "value": "Die Adresse „%@“ wirkt unvollständig. Achten Sie auf einen Namen, ein @-Zeichen und eine Domain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección “%@” no parece completa. Asegúrate de que tenga un nombre, una @ y un dominio."
          }
        },
        "fr": {
          "stringUnit": {
