    "Drag the handles to reorder, or with VoiceOver use the Move up and Move down actions. Hidden sections stay saved but are left out of the document.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie an den Griffen, um die Reihenfolge zu ändern, oder nutzen Sie mit VoiceOver die Aktionen Nach oben und Nach unten. Ausgeblendete Abschnitte bleiben gespeichert, erscheinen aber nicht im Dokument."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los controladores para reordenar o, con VoiceOver, usa las acciones Subir y Bajar. Las secciones ocultas se guardan, pero no aparecen en el documento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les poignées pour réorganiser ou, avec VoiceOver, utilisez les actions Monter et Descendre. Les sections masquées restent enregistrées mais n’apparaissent pas dans le document."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动手柄可调整顺序；使用旁白时可用“上移”和“下移”操作。隐藏的板块仍会保存，但不会出现在文档中。"
          }
        }
      }
    },
    "Drag to move and pinch to zoom, or use the buttons below.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Verschieben ziehen, zum Zoomen auf- und zuziehen oder die Tasten unten verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para mover y pellizca para hacer zoom, o usa los botones de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour déplacer et pincez pour zoomer, ou utilisez les boutons ci-dessous."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可移动，双指捏合可缩放，也可以使用下方按钮。"
          }
        }
      }
    },
