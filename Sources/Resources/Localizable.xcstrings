        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgebildeter Elektriker ohne Sicherheitsvorfälle, mit Erfahrung in Wohngebäuden und kleineren Gewerbeinstallationen. Arbeitet sauber, erklärt Kunden die Arbeiten und hält Termine ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Electricista cualificado sin incidentes de seguridad y con experiencia en instalaciones residenciales y pequeños locales comerciales. Trabaja con orden, explica el trabajo a los clientes y termina en plazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Électricien qualifié sans incident de sécurité, expérimenté en installations résidentielles et petit tertiaire. Travaille proprement, explique l’intervention aux clients et termine dans les délais."
