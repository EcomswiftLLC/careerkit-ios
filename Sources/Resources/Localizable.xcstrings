    "This template has no photo area": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Vorlage hat keinen Fotobereich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta plantilla no tiene espacio para foto"
          }
        },
