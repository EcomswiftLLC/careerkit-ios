            "value": "La extensión está dentro de lo que esperan la mayoría de los empleadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La longueur correspond à ce qu'attendent la plupart des employeurs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "篇幅在大多数雇主的预期范围内。"
          }
        }
      }
    },
    "The name is only for you. It does not appear on the document.": {
      "comment": "Resume quick actions (Home, My Resumes)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
