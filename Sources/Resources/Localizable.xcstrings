    "Switching templates changes the look only. Your text stays as it is.": {
      "comment": "Cover letter template picker",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorlagenwechsel ändert nur das Aussehen. Ihr Text bleibt, wie er ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar de plantilla solo cambia el aspecto. Tu texto no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer de modèle modifie uniquement l’apparence. Votre texte reste tel quel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换模板只会改变外观，你的文字内容保持不变。"
