    "Text that could not be placed. It is kept here so nothing is lost; move or delete it in the editor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text, der nicht zugeordnet werden konnte. Er bleibt hier erhalten, damit nichts verloren geht. Verschieben oder löschen Sie ihn im Editor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto que no se pudo ubicar. Se guarda aquí para que no se pierda nada; muévelo o elimínalo en el editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte qui n'a pas pu être classé. Il est conservé ici pour ne rien perdre ; déplacez-le ou supprimez-le dans l'éditeur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法归类的文字。为避免丢失内容会保留在这里，你可以在编辑器中移动或删除。"
          }
        }
      }
    },
    "Thank the reader and say how to reach you.": {
      "comment": "Cover letter editor form",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedanken Sie sich und nennen Sie, wie man Sie erreicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da las gracias al lector e indica cómo contactarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remerciez le lecteur et indiquez comment vous joindre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢阅读者，并说明联系你的方式。"
          }
        }
      }
    },
