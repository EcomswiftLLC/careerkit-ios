    "Improved page load time by 40 percent by optimizing images and removing unused code.": {
      "comment": "Writing examples library (resume example text the person can insert). Fictional, generic.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbesserung der Ladezeit um 40 Prozent durch optimierte Bilder und das Entfernen ungenutzten Codes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejoré un 40 por ciento el tiempo de carga de la página optimizando imágenes y eliminando código sin uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amélioré de 40 pour cent le temps de chargement des pages en optimisant les images et en supprimant le code inutilisé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过优化图片和清理无用代码，将页面加载速度提升 40％。"
