            "value": "Führung der Patientenakten gemäß Datenschutzvorgaben; alle internen Audits bestanden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantuve los historiales de los pacientes conforme a la normativa de privacidad y superé todas las auditorías internas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenu les dossiers patients conformément aux règles de confidentialité et réussi tous les audits internes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按照隐私规定管理患者档案，顺利通过每一次内部审核。"
          }
        }
      }
    },
