    "Small caps": {
      "extractionState": "manual",
      "localizations": {}
    },
    "Software ignores photos, and in some countries employers prefer resumes without one. Check the norm for where you are applying.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Software ignoriert Fotos, und in manchen Ländern bevorzugen Arbeitgeber Lebensläufe ohne Foto. Prüfen Sie, was dort üblich ist, wo Sie sich bewerben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El software ignora las fotos y, en algunos países, los empleadores prefieren currículums sin ella. Consulta la costumbre del lugar donde te postulas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les logiciels ignorent les photos et, dans certains pays, les employeurs préfèrent les CV sans photo. Renseignez-vous sur l'usage là où vous postulez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件会忽略照片，而且在一些国家，雇主更喜欢不带照片的简历。请了解目标地区的惯例。"
          }
        }
      }
    },
    "Software may not recognise %@. Common names such as Work Experience, Education and Skills are safer.": {
      "comment": "The placeholder is a list of quoted headings from the resume.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Software erkennt %@ möglicherweise nicht. Übliche Namen wie Berufserfahrung, Ausbildung und Kenntnisse sind sicherer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que el software no reconozca %@. Nombres habituales como Experiencia laboral, Educación y Habilidades son más seguros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un logiciel risque de ne pas reconnaître %@. Des titres courants comme Expérience professionnelle, Formation et Compétences sont plus sûrs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件可能无法识别 %@。使用“工作经历”“教育背景”“技能”等常见名称更稳妥。"
          }
        }
      }
    },
    "Software needs real text, not an image of text. Try another template and check again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Software braucht echten Text, kein Bild von Text. Probieren Sie eine andere Vorlage und prüfen Sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El software necesita texto real, no una imagen de texto. Prueba otra plantilla y vuelve a revisar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un logiciel a besoin de vrai texte, pas d'une image de texte. Essayez un autre modèle et vérifiez à nouveau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件需要真正的文字，而不是文字图片。请换一个模板后再检查。"
          }
        }
      }
    },
    "Solid bar": {
      "extractionState": "manual",
      "localizations": {}
    },
    "Some bullet points are long": {
      "extractionState": "manual",
      "localizations": {
